            <gradient
                android:startX="24"
                android:startY="56"
                android:endX="84"
                android:endY="77"
                android:type="linear">
                <item android:offset="0.0" android:color="#CCFDA4AF" />
                <item android:offset="0.5" android:color="#FFE2E8F0" />
                <item android:offset="1.0" android:color="#CCFDA4AF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M24,56 C34,68 44,74 54,74 C64,74 74,68 84,56"
        android:strokeWidth="1.4"
        android:strokeColor="#FFFFE4E6"
        android:fillColor="#00000000" />

    <!-- Top Radiant 4-Pointed Star -->
    <path
        android:pathData="M54,12 C54,17 52.5,19 47,19 C52.5,19 54,21 54,26 C54,21 55.5,19 61,19 C55.5,19 54,17 54,12 Z"
        android:fillColor="#FFFFFF" />

    <!-- Soft Star Glow Aura -->
    <path
        android:pathData="M54,19m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="19"
                android:gradientRadius="4.5"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.4" android:color="#80FDA4AF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
