                <item android:offset="0.75" android:color="#FB7185" />
                <item android:offset="1.0" android:color="#E11D48" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top North Star Light Beam -->
    <path
        android:pathData="M54,20 L54,56"
        android:strokeWidth="1.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="20"
                android:endX="54"
                android:endY="56"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.4" android:color="#CCFFE4E6" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base Crescent Glow Dome (Layer 1) -->
    <path
        android:pathData="M54,46 C67,46 78,57 78,70 C78,83 67,89 54,89 C41,89 30,83 30,70 C30,57 41,46 54,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="46"
                android:endX="54"
                android:endY="89"
                android:type="linear">
                <item android:offset="0.0" android:color="#66D8B4FE" />
                <item android:offset="0.5" android:color="#807C3AED" />
                <item android:offset="1.0" android:color="#403B0764" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Lotus Petals Wing (Layer 2) -->
    <path
        android:pathData="M18,52 C26,67 38,79 54,79 C70,79 82,67 90,52 C84,70 69,84 54,84 C39,84 24,70 18,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="52"
                android:endX="90"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#99C4B5FD" />
                <item android:offset="0.5" android:color="#B3A78BFA" />
                <item android:offset="1.0" android:color="#99C4B5FD" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M18,52 C26,67 38,79 54,79 C70,79 82,67 90,52"
        android:strokeWidth="1.2"
        android:strokeColor="#D0E9D5FF"
        android:fillColor="#00000000" />

