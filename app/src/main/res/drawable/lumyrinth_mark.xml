<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outermost Atmospheric Glow Sphere -->
    <path
        android:pathData="M54,56m-34,0a34,34 0 1,1 68,0a34,34 0 1,1 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="34"
                android:type="radial">
                <item android:offset="0.0" android:color="#40E879F9" />
                <item android:offset="0.5" android:color="#20A855F7" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Concentric Orbit Ring 1 (Outer) -->
    <path
        android:pathData="M54,56m-31,0a31,31 0 1,1 62,0a31,31 0 1,1 -62,0"
        android:strokeWidth="0.9"
        android:strokeColor="#50C084FC"
        android:fillColor="#00000000" />

    <!-- Concentric Orbit Ring 2 -->
    <path
        android:pathData="M54,56m-24,0a24,24 0 1,1 48,0a24,24 0 1,1 -48,0"
        android:strokeWidth="1.1"
        android:strokeColor="#70E879F9"
        android:fillColor="#00000000" />

    <!-- Concentric Orbit Ring 3 -->
    <path
        android:pathData="M54,56m-17,0a17,17 0 1,1 34,0a17,17 0 1,1 -34,0"
        android:strokeWidth="1.3"
        android:strokeColor="#A0F472B6"
        android:fillColor="#00000000" />

    <!-- Concentric Orbit Ring 4 (Inner halo) -->
    <path
        android:pathData="M54,56m-11,0a11,11 0 1,1 22,0a11,11 0 1,1 -22,0"
        android:strokeWidth="1.4"
        android:strokeColor="#D0FFD6E8"
        android:fillColor="#00000000" />

    <!-- Radiant Glowing Center Sun Core -->
    <path
        android:pathData="M54,56m-10.5,0a10.5,10.5 0 1,1 21,0a10.5,10.5 0 1,1 -21,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="10.5"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFF" />
